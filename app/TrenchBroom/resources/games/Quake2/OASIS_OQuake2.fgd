// OASIS Omniverse — OQuake2 entity definitions for TrenchBroom
// Thing type range: 6001–6899 (OQuake2 / OQuake2-RTX shared)
// Portal: 5900 (shared cross-game)

@PointClass color(0 192 255) size(-12 -12 -12, 12 12 12) = oasis_portal : "OASIS Omniverse cross-game portal. Connects this map to other OASIS Omniverse games. OASIS thing type 5900."
[
    oasis_game_id(string) : "Target OGame ID" : "" : "The OGame this portal leads to (e.g. oquake, odoom, oquake3, oduke3d)"
    targetname(target_source) : "Portal name"
    target(target_destination) : "Portal target"
]

@PointClass color(0 128 255) size(-8 -8 -8, 8 8 8) = oasis_key_blue : "OASIS blue keycard — unlocks blue key doors cross-game. OASIS thing type 6001. Classname: item_key_blue_key"
[
    targetname(target_source) : "Key name"
]

@PointClass color(255 0 0) size(-8 -8 -8, 8 8 8) = oasis_key_red : "OASIS red keycard — unlocks red key doors cross-game. OASIS thing type 6002. Classname: item_key_red_key"
[
    targetname(target_source) : "Key name"
]

@PointClass color(180 180 0) size(-8 -8 -8, 8 8 8) = oasis_key_commanders_head : "Commander's Head — special mission key. OASIS thing type 6003."
[
    targetname(target_source) : "Key name"
]
